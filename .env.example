# Copy to .env.local for local development (it is git-ignored) and set the same
# variables in Vercel > Project Settings > Environment Variables for production.
# Never commit real values. Variables starting with VITE_ are bundled into the
# browser; everything else is server-only (api/ functions and backend/).

# --- AI (server-only) ---
# Claude key for the skin report and facial-harmony report
# (api/generate-skincare.js, api/generate-recommendations.js).
ANTHROPIC_API_KEY=
# Optional: override the Claude model (defaults to claude-haiku-5-5).
ANTHROPIC_MODEL=
# OpenAI key for the personal color and hairstyle images
# (api/generate-color-analysis.js, api/generate-hairstyle-analysis.js).
OPENAI_API_KEY=

# --- Clerk ---
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Dodo Payments ---
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_MODE=
# The subscription product ("$0.99 first month, then monthly", see SUBSCRIPTION_SETUP.md). Test and live
# mode have different product ids: use the test one with an sk_test_ key and the live one with sk_live_.
# api/checkout.js refuses to start a checkout without it.
DODO_PAYMENTS_SUBSCRIPTION_PRODUCT_ID=
# The OLD product, no longer used for checkout. Safe to leave set or delete.
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_SUCCESS_URL=
# Signing secret of the webhook endpoint pointing at /api/webhooks/dodo (Dodo > Developer > Webhooks).
DODO_PAYMENTS_WEBHOOK_KEY=

# Digital footprint uses the existing server-only ANTHROPIC_API_KEY and DODO_PAYMENTS_API_KEY.

# --- Other webhooks ---
RANKONGEO_WEBHOOK_SECRET=

# Digital-footprint experiment (server-only search key)


# Footprint checkout reuses server-only DODO_PAYMENTS_API_KEY and DODO_PAYMENTS_MODE.
