{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap-blog.xml", "destination": "/api/sitemap-blog" },
    { "source": "/blog", "destination": "/api/blog-index" },
    { "source": "/blog/:slug", "destination": "/api/blog-post?slug=:slug" },
    { "source": "/(.*)", "destination": "/spa.html" }
  ]
}
